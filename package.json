{
  "name": "chef-yosef-pizza",
  "version": "1.0.0",
  "description": "פיצריית השף יוסף",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.chefyosef.pizza",
    "productName": "פיצריית השף יוסף",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        { "target": "portable" }
      ]
    },
    "files": [
      "**/*",
      "!dist/**",
      "!node_modules/.cache/**"
    ]
  }
}
