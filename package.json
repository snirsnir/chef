{
  "name": "chef-yosef-pizza",
  "version": "2.0.0",
  "description": "פיצריית השף יוסף",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.chefyosef.pizza",
    "productName": "פיצריית השף יוסף",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        { "target": "nsis" }
      ]
    },
    "asar": false,
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "פיצריית השף יוסף",
      "artifactName": "פיצריית השף יוסף 2.0.${ext}"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!build/**",
      "!node_modules/**"
    ]
  }
}
